<?xml version="1.0" encoding="UTF-8" ?>
<!-- FastDDS profile: UDP unicast only, no shared memory, no multicast.
     - Eliminates stale /dev/shm segments from killed processes blocking rclpy.init().
     - Disables multicast discovery to prevent DDS thundering-herd on HPC nodes where
       many participants start simultaneously and flood the subnet with announcements.
     - All discovery uses localhost unicast; works for single-node (same machine) runs. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>udp_only</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="default_profile" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>udp_only</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
      <builtin>
        <!-- No multicast: announce and discover via unicast on localhost only -->
        <metatrafficMulticastLocatorList/>
        <metatrafficUnicastLocatorList>
          <locator>
            <udpv4>
              <address>127.0.0.1</address>
            </udpv4>
          </locator>
        </metatrafficUnicastLocatorList>
        <initialPeersList>
          <locator>
            <udpv4>
              <address>127.0.0.1</address>
            </udpv4>
          </locator>
        </initialPeersList>
      </builtin>
    </rtps>
  </participant>
</profiles>
