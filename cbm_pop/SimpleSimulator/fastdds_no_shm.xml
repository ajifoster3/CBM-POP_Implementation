<?xml version="1.0" encoding="UTF-8" ?>
<!-- FastDDS profile: UDP only, no shared memory.
     Prevents stale /dev/shm segments from killed processes blocking rclpy.init()
     on the next run.  Multicast discovery is left enabled because it is the most
     efficient mechanism when many participants start simultaneously on the same
     machine — each sends one multicast announcement and all others receive it.
     Cross-host and cross-job isolation is handled at a higher level:
       ROS_LOCALHOST_ONLY=1   — keeps multicast on the loopback interface only
       ROS_DOMAIN_ID          — isolates concurrent SLURM jobs from each other -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>udp_only</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="default_profile" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>udp_only</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
